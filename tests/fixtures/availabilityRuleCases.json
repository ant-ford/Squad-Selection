{
  "about": "Availability rule cases, run against BOTH engines: the TypeScript one (tests/availabilityRuleCases.test.ts: resolveRuleStatus, needsExplicitAvailable, and setAvailability through the fake repositories) and the SQL one (scripts/availability-rule-checks.mjs writes the checks for availability_rule_status and set_availability, run on preview in a rolled-back transaction). ruleStatus = what the player's standing rules give the fixture (null: none applies). storeAvailable = whether an Available answer is STORED (true) or expressed by deleting the row (false). Rules are listed in api_id order. 2026-10-10 is a Saturday, 2026-10-14 a Wednesday. A date of \"\" is a match with no date.",
  "cases": [
    { "name": "no rules, club default", "rules": [], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "no rules, Opt-In Only", "optInOnly": true, "rules": [], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": true },
    { "name": "All future Unavailable", "rules": [{ "ruleType": "All future", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "All future Maybe", "rules": [{ "ruleType": "All future", "availability": "Maybe" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "All future Available", "rules": [{ "ruleType": "All future", "availability": "Available" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Available", "storeAvailable": false },
    { "name": "Opt-In Only above an Available rule", "optInOnly": true, "rules": [{ "ruleType": "All future", "availability": "Available" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Available", "storeAvailable": true },
    { "name": "All future from a later date", "rules": [{ "ruleType": "All future", "availability": "Maybe", "startDate": "2026-11-01" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "All future from the same day", "rules": [{ "ruleType": "All future", "availability": "Maybe", "startDate": "2026-10-10" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "inactive rule ignored", "rules": [{ "ruleType": "All future", "availability": "Unavailable", "active": false }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "rule with no availability ignored", "rules": [{ "ruleType": "All future", "availability": "" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "rule with no type ignored", "rules": [{ "ruleType": "", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Midweek on a Saturday", "rules": [{ "ruleType": "Midweek", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Midweek on a Sunday", "rules": [{ "ruleType": "Midweek", "availability": "Unavailable" }], "fixture": { "date": "2026-10-11" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Midweek on a Monday", "rules": [{ "ruleType": "Midweek", "availability": "Unavailable" }], "fixture": { "date": "2026-10-12" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Midweek on a Wednesday", "rules": [{ "ruleType": "Midweek", "availability": "Maybe" }], "fixture": { "date": "2026-10-14" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "Midweek on a Friday", "rules": [{ "ruleType": "Midweek", "availability": "Unavailable" }], "fixture": { "date": "2026-10-16" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Play-ups on a play-up", "rules": [{ "ruleType": "Play-ups", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10", "isPlayUp": true }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Play-ups on own level", "rules": [{ "ruleType": "Play-ups", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Play-ups on a support game", "rules": [{ "ruleType": "Play-ups", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10", "isSupport": true }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Support games on a support game", "rules": [{ "ruleType": "Support games", "availability": "Maybe" }], "fixture": { "date": "2026-10-10", "isSupport": true }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "Support games on a play-up", "rules": [{ "ruleType": "Support games", "availability": "Maybe" }], "fixture": { "date": "2026-10-10", "isPlayUp": true }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Date range inside", "rules": [{ "ruleType": "Date range", "availability": "Unavailable", "startDate": "2026-10-01", "endDate": "2026-10-31" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Date range on its first day", "rules": [{ "ruleType": "Date range", "availability": "Unavailable", "startDate": "2026-10-10", "endDate": "2026-10-31" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Date range on its last day", "rules": [{ "ruleType": "Date range", "availability": "Unavailable", "startDate": "2026-10-01", "endDate": "2026-10-10" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Date range ended the day before", "rules": [{ "ruleType": "Date range", "availability": "Unavailable", "startDate": "2026-10-01", "endDate": "2026-10-09" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Date range starts the day after", "rules": [{ "ruleType": "Date range", "availability": "Unavailable", "startDate": "2026-10-11", "endDate": "2026-10-31" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Date range with a start only", "rules": [{ "ruleType": "Date range", "availability": "Maybe", "startDate": "2026-10-01" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "Date range with an end only", "rules": [{ "ruleType": "Date range", "availability": "Maybe", "endDate": "2026-10-31" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "Date range with no dates matches nothing", "rules": [{ "ruleType": "Date range", "availability": "Unavailable" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "Midweek beats All future", "rules": [{ "ruleType": "All future", "availability": "Unavailable" }, { "ruleType": "Midweek", "availability": "Available" }], "fixture": { "date": "2026-10-14" }, "ruleStatus": "Available", "storeAvailable": false },
    { "name": "All future applies where Midweek does not", "rules": [{ "ruleType": "All future", "availability": "Unavailable" }, { "ruleType": "Midweek", "availability": "Available" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Date range beats Midweek", "rules": [{ "ruleType": "Midweek", "availability": "Available" }, { "ruleType": "Date range", "availability": "Unavailable", "startDate": "2026-10-12", "endDate": "2026-10-18" }], "fixture": { "date": "2026-10-14" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "Date range Available beats All future Unavailable", "rules": [{ "ruleType": "All future", "availability": "Unavailable" }, { "ruleType": "Date range", "availability": "Available", "startDate": "2026-10-10", "endDate": "2026-10-10" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Available", "storeAvailable": false },
    { "name": "Play-ups beats All future", "rules": [{ "ruleType": "All future", "availability": "Unavailable" }, { "ruleType": "Play-ups", "availability": "Available" }], "fixture": { "date": "2026-10-10", "isPlayUp": true }, "ruleStatus": "Available", "storeAvailable": false },
    { "name": "Midweek beats Support games", "rules": [{ "ruleType": "Support games", "availability": "Available" }, { "ruleType": "Midweek", "availability": "Maybe" }], "fixture": { "date": "2026-10-14", "isSupport": true }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "same type: the newer wins", "rules": [{ "ruleType": "All future", "availability": "Unavailable", "lastModified": "2026-09-01T10:00:00.000Z" }, { "ruleType": "All future", "availability": "Available", "lastModified": "2026-09-02T10:00:00.000Z" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Available", "storeAvailable": false },
    { "name": "same type: the newer wins when listed first", "rules": [{ "ruleType": "All future", "availability": "Unavailable", "lastModified": "2026-09-02T10:00:00.000Z" }, { "ruleType": "All future", "availability": "Available", "lastModified": "2026-09-01T10:00:00.000Z" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "same type: a millisecond decides", "rules": [{ "ruleType": "Midweek", "availability": "Maybe", "lastModified": "2026-09-01T10:00:00.001Z" }, { "ruleType": "Midweek", "availability": "Available", "lastModified": "2026-09-01T10:00:00.000Z" }], "fixture": { "date": "2026-10-14" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "same type and time: the first in api_id order", "rules": [{ "ruleType": "All future", "availability": "Maybe", "lastModified": "2026-09-01T10:00:00.000Z" }, { "ruleType": "All future", "availability": "Unavailable", "lastModified": "2026-09-01T10:00:00.000Z" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "same type and time: Available first", "rules": [{ "ruleType": "All future", "availability": "Available", "lastModified": "2026-09-01T10:00:00.000Z" }, { "ruleType": "All future", "availability": "Unavailable", "lastModified": "2026-09-01T10:00:00.000Z" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Available", "storeAvailable": false },
    { "name": "Play-ups and Support games tie: the newer wins", "rules": [{ "ruleType": "Play-ups", "availability": "Unavailable", "lastModified": "2026-09-01T10:00:00.000Z" }, { "ruleType": "Support games", "availability": "Maybe", "lastModified": "2026-09-02T10:00:00.000Z" }], "fixture": { "date": "2026-10-10", "isPlayUp": true, "isSupport": true }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "inactive newer rule does not hide an older one", "rules": [{ "ruleType": "All future", "availability": "Unavailable", "lastModified": "2026-09-01T10:00:00.000Z" }, { "ruleType": "All future", "availability": "Available", "active": false, "lastModified": "2026-09-02T10:00:00.000Z" }], "fixture": { "date": "2026-10-10" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "no date: All future without a start", "rules": [{ "ruleType": "All future", "availability": "Unavailable" }], "fixture": { "date": "" }, "ruleStatus": "Unavailable", "storeAvailable": true },
    { "name": "no date: All future with a start", "rules": [{ "ruleType": "All future", "availability": "Unavailable", "startDate": "2026-10-01" }], "fixture": { "date": "" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "no date: Midweek", "rules": [{ "ruleType": "Midweek", "availability": "Unavailable" }], "fixture": { "date": "" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "no date: Date range with an end only", "rules": [{ "ruleType": "Date range", "availability": "Maybe", "endDate": "2026-10-31" }], "fixture": { "date": "" }, "ruleStatus": "Maybe", "storeAvailable": true },
    { "name": "no date: Date range with a start", "rules": [{ "ruleType": "Date range", "availability": "Maybe", "startDate": "2026-10-01", "endDate": "2026-10-31" }], "fixture": { "date": "" }, "ruleStatus": null, "storeAvailable": false },
    { "name": "no date: Opt-In Only", "optInOnly": true, "rules": [], "fixture": { "date": "" }, "ruleStatus": null, "storeAvailable": true }
  ]
}
