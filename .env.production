# Production build values. Merged over .env by `vite build` (mode=production),
# so local dev keeps using the localhost API in .env.
# Committed deliberately: this holds no secrets, and a wrong value here bakes
# the wrong API origin into the deployed bundle.
VITE_API_URL=https://api.eddy.global

VITE_SUPABASE_URL=https://biipqddulsbjpbmxuoss.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_nwMTI17uq3Uk2u5tnm9g2w_0AZ_Vvod

# Cloudflare Turnstile before the sign-in email (src/components/Turnstile.tsx).
# The site key is public by design; the secret lives only in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFPGeYb1Dp_pX6TW
