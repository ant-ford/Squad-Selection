{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hkfc-squad-selection",
  "compatibility_date": "2026-07-04",
  "observability": {
    "enabled": true
  },
  // Serve the app from the club's own domain instead of *.workers.dev.
  // `custom_domain: true` makes `wrangler deploy` create the DNS record and
  // certificate automatically; the eddy.global zone must be in the same
  // Cloudflare account.
  // workers_dev defaults to true, but it is stated explicitly so the
  // *.workers.dev hostname is never dropped by accident while both are in use.
  "workers_dev": true,
  "routes": [
    { "pattern": "app.eddy.global", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
