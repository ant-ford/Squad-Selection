# `npm run dev:preview-api`: the local frontend against the branch preview
# API (hkfc-api-preview, deployed by .github/workflows/preview.yml).
# Self-contained, so it works without a local .env. Committed on purpose,
# like .env.production: every value is public.
#
# The preview API only accepts http://localhost:5173, so keep the default
# Vite port. If a run's summary shows a different URL, use that.
VITE_API_URL=https://hkfc-api-preview.squad-selections.workers.dev

# Same Supabase project as production (public publishable values).
VITE_SUPABASE_URL=https://rttbghxnacfrhjzzjwnh.supabase.co
